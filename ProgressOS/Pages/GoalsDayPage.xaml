<UserControl x:Class="ProgressOS.Pages.GoalsDayPages"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProgressOS.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Стиль для скругленных TextBox -->
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderThickness="0">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                         Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для скругленных кнопок -->
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопок действий (редактирование, удаление) -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопки отмены -->
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Здесь был Grid, который теперь обернут в корневой элемент -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель с заголовком и кнопкой добавления -->
        <Border Grid.Row="0" 
                Background="Transparent"
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Ежедневные цели" 
                             Foreground="{StaticResource TextPrimaryBrush}" 
                             FontSize="28" 
                             FontWeight="Bold"/>
                    <TextBlock Text="Управляйте своими ежедневными задачами и отслеживайте прогресс" 
                             Foreground="{StaticResource TextSecondaryBrush}" 
                             FontSize="14"
                             Margin="0,5,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource RoundedButton}"
                        Padding="20,12"
                        Click="AddGoal_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+" FontSize="18" FontWeight="Bold" Margin="0,0,8,0"/>
                        <TextBlock Text="Новая цель" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Основной контент - список целей -->
        <ScrollViewer Grid.Row="1" 
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Список целей -->
                <ItemsControl x:Name="GoalsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" 
                                    Background="{StaticResource CardBrush}"
                                    Margin="0,0,0,15"
                                    Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Заголовок цели -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" 
                                                 Foreground="{StaticResource TextPrimaryBrush}" 
                                                 FontSize="18" 
                                                 FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding DateCreate}" 
                                                 Foreground="{StaticResource TextSecondaryBrush}" 
                                                 FontSize="11"
                                                 Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <!-- Кнопки действий -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" 
                                              Orientation="Horizontal">
                                        <Button Style="{StaticResource ActionButtonStyle}"
                                                Click="EditGoal_Click"
                                                Tag="{Binding}">
                                            <TextBlock Text="✏️" FontSize="16"/>
                                        </Button>
                                        <Button Style="{StaticResource ActionButtonStyle}"
                                                Click="DeleteGoal_Click"
                                                Tag="{Binding}"
                                                Margin="5,0,0,0">
                                            <TextBlock Text="🗑️" FontSize="16"/>
                                        </Button>
                                    </StackPanel>

                                    <!-- Описание -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                             Text="{Binding Description}" 
                                             Foreground="{StaticResource TextSecondaryBrush}" 
                                             FontSize="13"
                                             TextWrapping="Wrap"
                                             Margin="0,10,0,10"/>

                                    <!-- Прогресс -->
                                    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="Прогресс: " 
                                                         Foreground="{StaticResource TextSecondaryBrush}" 
                                                         FontSize="12"/>
                                                <TextBlock Text="{Binding CurrentProgress}" 
                                                         Foreground="{StaticResource PrimaryBrush}" 
                                                         FontSize="12" 
                                                         FontWeight="Bold"/>
                                                <TextBlock Text=" / " 
                                                         Foreground="{StaticResource TextSecondaryBrush}" 
                                                         FontSize="12"/>
                                                <TextBlock Text="{Binding TotalProgress}" 
                                                         Foreground="{StaticResource TextSecondaryBrush}" 
                                                         FontSize="12"/>
                                            </StackPanel>
                                            <ProgressBar Style="{StaticResource ProgressBarStyle}" 
                                                       Value="{Binding ProgressPercent}" 
                                                       Height="6"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Style="{StaticResource RoundedButton}"
                                                Padding="15,8"
                                                Margin="15,0,0,0"
                                                Click="UpdateProgress_Click"
                                                Tag="{Binding}">
                                            <TextBlock Text="Обновить прогресс" 
                                                     FontSize="12"
                                                     FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Сообщение, если нет целей -->
                <Border x:Name="NoGoalsMessage"
                        Style="{StaticResource CardStyle}"
                        Background="{StaticResource CardBrush}"
                        Padding="40"
                        Margin="0,20,0,0"
                        Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📅" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="Нет ежедневных целей" 
                                 Foreground="{StaticResource TextPrimaryBrush}" 
                                 FontSize="18" 
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Center"
                                 Margin="0,15,0,5"/>
                        <TextBlock Text="Создайте свою первую ежедневную цель, чтобы начать отслеживать прогресс" 
                                 Foreground="{StaticResource TextSecondaryBrush}" 
                                 FontSize="13"
                                 HorizontalAlignment="Center"
                                 TextWrapping="Wrap"/>
                        <Button Style="{StaticResource RoundedButton}"
                                Padding="20,10"
                                Margin="0,20,0,0"
                                Click="AddGoal_Click">
                            <TextBlock Text="➕ Создать цель" 
                                     FontSize="14"
                                     FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Диалог добавления/редактирования цели -->
        <Border x:Name="GoalDialog" 
                Background="#80000000"
                Visibility="Collapsed"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Style="{StaticResource CardStyle}"
                    Background="{StaticResource SurfaceBrush}"
                    Width="500"
                    Height="Auto"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Margin="25">
                    <TextBlock x:Name="DialogTitle" 
                             Text="Новая цель" 
                             Foreground="{StaticResource TextPrimaryBrush}" 
                             FontSize="20" 
                             FontWeight="Bold"
                             Margin="0,0,0,20"/>

                    <!-- Название цели -->
                    <TextBlock Text="Название цели" 
                             Foreground="{StaticResource TextSecondaryBrush}" 
                             FontSize="12"
                             Margin="0,0,0,5"/>
                    <TextBox x:Name="GoalNameTextBox" 
                            Style="{StaticResource RoundedTextBox}"
                            Margin="0,0,0,15"/>

                    <!-- Описание -->
                    <TextBlock Text="Описание" 
                             Foreground="{StaticResource TextSecondaryBrush}" 
                             FontSize="12"
                             Margin="0,0,0,5"/>
                    <TextBox x:Name="GoalDescriptionTextBox" 
                            Style="{StaticResource RoundedTextBox}"
                            Height="80"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            Margin="0,0,0,15"/>

                    <!-- Прогресс -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Текущий прогресс" 
                                     Foreground="{StaticResource TextSecondaryBrush}" 
                                     FontSize="12"
                                     Margin="0,0,0,5"/>
                            <TextBox x:Name="CurrentProgressTextBox" 
                                    Style="{StaticResource RoundedTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Целевой прогресс" 
                                     Foreground="{StaticResource TextSecondaryBrush}" 
                                     FontSize="12"
                                     Margin="0,0,0,5"/>
                            <TextBox x:Name="TotalProgressTextBox" 
                                    Style="{StaticResource RoundedTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Кнопки -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource CancelButtonStyle}"
                                Click="CancelDialog_Click">
                            <TextBlock Text="Отмена" 
                                     Foreground="{StaticResource TextSecondaryBrush}" 
                                     FontSize="14"/>
                        </Button>
                        <Button Style="{StaticResource RoundedButton}"
                                Padding="20,10"
                                Margin="10,0,0,0"
                                Click="SaveGoal_Click">
                            <TextBlock Text="Сохранить" 
                                     FontSize="14"
                                     FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Диалог обновления прогресса -->
        <Border x:Name="ProgressDialog" 
                Background="#80000000"
                Visibility="Collapsed"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Style="{StaticResource CardStyle}"
                    Background="{StaticResource SurfaceBrush}"
                    Width="400"
                    Height="Auto"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Margin="25">
                    <TextBlock Text="Обновить прогресс" 
                             Foreground="{StaticResource TextPrimaryBrush}" 
                             FontSize="20" 
                             FontWeight="Bold"
                             Margin="0,0,0,20"/>

                    <TextBlock x:Name="ProgressGoalName" 
                             Foreground="{StaticResource TextSecondaryBrush}" 
                             FontSize="14"
                             Margin="0,0,0,15"/>

                    <TextBlock Text="Новый прогресс" 
                             Foreground="{StaticResource TextSecondaryBrush}" 
                             FontSize="12"
                             Margin="0,0,0,5"/>
                    <TextBox x:Name="NewProgressTextBox" 
                            Style="{StaticResource RoundedTextBox}"
                            Margin="0,0,0,15"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource CancelButtonStyle}"
                                Click="CancelProgressDialog_Click">
                            <TextBlock Text="Отмена" 
                                     Foreground="{StaticResource TextSecondaryBrush}" 
                                     FontSize="14"/>
                        </Button>
                        <Button Style="{StaticResource RoundedButton}"
                                Padding="20,10"
                                Margin="10,0,0,0"
                                Click="SaveProgress_Click">
                            <TextBlock Text="Обновить" 
                                     FontSize="14"
                                     FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>