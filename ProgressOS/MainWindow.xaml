<Window x:Class="ProgressOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProgressOS"
        mc:Ignorable="d"
        Title="ProgresOS" 
        Height="900" 
        Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#0A0A0A"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowState="Normal">

    <Grid>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0A0A0A" Offset="0"/>
                    <GradientStop Color="#151515" Offset="0.5"/>
                    <GradientStop Color="#1A1A1A" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" 
                    Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0">
                        <Border Background="{StaticResource PrimaryBrush}" 
                                Width="28" 
                                Height="28" 
                                CornerRadius="8">
                            <TextBlock Text="P" 
                                     Foreground="White" 
                                     FontSize="18" 
                                     FontWeight="Bold"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="ProgresOS" 
                                 Foreground="White" 
                                 FontSize="18" 
                                 FontWeight="SemiBold"
                                 Margin="10,0,0,0"
                                 VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="MinimizeButton" 
                               Style="{StaticResource WindowButtonStyle}" 
                               Content="─"
                               Click="MinimizeButton_Click"/>
                        <Button x:Name="MaximizeButton" 
                               Style="{StaticResource WindowButtonStyle}" 
                               Content="□"
                               Click="MaximizeButton_Click"/>
                        <Button x:Name="CloseButton" 
                               Style="{StaticResource CloseButtonStyle}" 
                               Content="✕"
                               Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" 
                        Background="{StaticResource SurfaceBrush}" 
                        CornerRadius="24"
                        Margin="0,0,15,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" 
                                Background="{StaticResource CardBrush}"
                                CornerRadius="24 24 0 0"
                                Padding="20">
                            <StackPanel>
                                <Border Width="100" 
                                        Height="100" 
                                        CornerRadius="30"
                                        Background="{StaticResource PrimaryBrush}"
                                        HorizontalAlignment="Center"
                                        Margin="0,10,0,15">
                                    <Border CornerRadius="28" 
                                            Background="{StaticResource SurfaceBrush}"
                                            Margin="3">
                                        <TextBlock Text="👤" 
                                                 FontSize="40" 
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                                    </Border>
                                </Border>

                                <TextBlock x:Name="UserNameText" 
                                         Text="Александр" 
                                         Foreground="{StaticResource TextPrimaryBrush}" 
                                         FontSize="20" 
                                         FontWeight="SemiBold"
                                         HorizontalAlignment="Center"/>
                                <TextBlock x:Name="UserNicknameText" 
                                         Text="@alex_dev" 
                                         Foreground="{StaticResource TextSecondaryBrush}" 
                                         FontSize="14"
                                         HorizontalAlignment="Center"
                                         Margin="0,4,0,0"/>

                                <Border Background="#2A2A2A"
                                        CornerRadius="20"
                                        Padding="12,6"
                                        Margin="0,15,0,0">
                                    <StackPanel Orientation="Horizontal" 
                                                HorizontalAlignment="Center">
                                        <Ellipse Width="8" 
                                                Height="8" 
                                                Fill="{StaticResource SecondaryBrush}"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Text="Активен" 
                                                 Foreground="{StaticResource TextSecondaryBrush}"
                                                 FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" 
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="МЕНЮ" 
                                         Foreground="{StaticResource TextSecondaryBrush}" 
                                         FontSize="11" 
                                         FontWeight="Bold"
                                         Margin="20,0,0,10"/>

                                <Button x:Name="HomeButton" 
                                       Style="{StaticResource NavButtonStyle}"
                                       Content="Главная"
                                       Tag="Home"
                                       Click="NavigateMain_Click">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🏠" FontSize="20"/>
                                                <TextBlock Text="{Binding}" Margin="12,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>

                                <Button x:Name="DailyGoalsButton" 
                                       Style="{StaticResource NavButtonStyle}"
                                       Content="Ежедневные цели"
                                       Tag="Daily"
                                       Click="NavigateDaysGoals_Click">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📅" FontSize="20"/>
                                                <TextBlock Text="{Binding}" Margin="12,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>

                                <Button x:Name="YearlyGoalsButton" 
                                       Style="{StaticResource NavButtonStyle}"
                                       Content="Годовые цели"
                                       Tag="Yearly"
                                       Click="NavigateYearsGoals_Click">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🎯" FontSize="20"/>
                                                <TextBlock Text="{Binding}" Margin="12,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>

                                <Button x:Name="SettingsButton" 
                                       Style="{StaticResource NavButtonStyle}"
                                       Content="Настройки"
                                       Tag="Settings"
                                       Click="NavigateSettings_Click">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚙️" FontSize="20"/>
                                                <TextBlock Text="{Binding}" Margin="12,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>

                                <Rectangle Height="1" 
                                         Fill="#2A2A2A" 
                                         Margin="20,20"/>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2" 
                                Background="{StaticResource CardBrush}"
                                CornerRadius="0 0 24 24"
                                Padding="20">
                            <StackPanel>
                                <TextBlock Text="Версия 1.0.0" 
                                         Foreground="{StaticResource TextSecondaryBrush}"
                                         FontSize="11"
                                         HorizontalAlignment="Center"/>
                                <TextBlock Text="© 2026 ProgresOS. developer sergxlove" 
                                         Foreground="{StaticResource TextSecondaryBrush}"
                                         FontSize="11"
                                         HorizontalAlignment="Center"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="0,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ContentControl x:Name="PageControl"
                        Grid.Row="1"
                        Background="{StaticResource SurfaceBrush}"
                        Padding="25"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">

                        <ContentControl.Content>
                            <Grid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="🏠" 
                                        FontSize="48" 
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        HorizontalAlignment="Center"/>
                                    <TextBlock Text="Выберите раздел в навигации" 
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        FontSize="16"
                                        Margin="0,20,0,0"
                                        HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </ContentControl.Content>
                    </ContentControl>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
